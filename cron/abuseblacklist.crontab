# AbuseBlacklist nightly update for Linux servers (on macOS use scripts/install_launchd_job.sh).
# Runs daily at 03:17 server time from a dedicated clean clone on main.
#
# APPEND it to your crontab; `crontab <file>` would replace every existing job:
#   (crontab -l 2>/dev/null; cat cron/abuseblacklist.crontab) | crontab -
#
# Edit the clone path below first. The script sets its own PATH, so no SHELL/PATH lines are needed here.
17 3 * * * /usr/bin/env bash /opt/AbuseBlacklist/scripts/run_daily_update.sh >> "$HOME/abuseblacklist-daily.log" 2>&1
